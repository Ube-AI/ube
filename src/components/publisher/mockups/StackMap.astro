---
import type { ImageMetadata } from "astro"
import Wordmark from "@/components/Wordmark.astro"
import { integrationLogos } from "@/lib/integration-logos"

type StackLogo = { name: string; src: ImageMetadata; invert?: boolean }

const stackLogos: StackLogo[] = [
  { name: "Firebase", src: integrationLogos.firebase },
  { name: "Amplitude", src: integrationLogos.amplitude },
  { name: "Clarity", src: integrationLogos.clarity },
  { name: "RevenueCat", src: integrationLogos.revenuecat },
  { name: "AppsFlyer", src: integrationLogos.appsflyer },
  { name: "AdMob", src: integrationLogos.admob },
  { name: "Google Ads", src: integrationLogos.googleAds },
  { name: "Meta", src: integrationLogos.meta },
  { name: "TikTok", src: integrationLogos.tiktok },
  { name: "Creatify", src: integrationLogos.creatify },
  { name: "Sett", src: integrationLogos.sett, invert: true },
]
---

<div class="stack-map" aria-label="Distribution stack integrations">
  <div class="stack-dotgrid" aria-hidden="true"></div>
  {/* Spans, not divs, so the nth-of-type node placement below keeps counting from 3. */}
  <span class="stack-halo" aria-hidden="true"></span>
  <span class="stack-halo" aria-hidden="true"></span>
  <span class="stack-halo" aria-hidden="true"></span>
  <div class="stack-core">
    <Wordmark size={32} />
    <strong>company brain</strong>
  </div>
  {
    stackLogos.map(({ name, src, invert }) => (
      <div class={`stack-node${invert ? " stack-node-invert" : ""}`}>
        <img src={src.src} alt="" loading="lazy" />
        <span>{name}</span>
      </div>
    ))
  }
</div>

<style>
  .stack-map {
    position: relative;
    min-height: 480px;
    background: radial-gradient(
      circle at center,
      var(--accent-tint),
      transparent 46%
    );
  }
  .stack-dotgrid {
    position: absolute;
    inset: -8%;
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.1) 1px,
      transparent 1.2px
    );
    background-size: 22px 22px;
    pointer-events: none;
    mask-image:
      linear-gradient(to right, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
    z-index: 0;
  }
  /* Halo rings. Emitted from behind the core: they start at scale 0.42
     (~137px, smaller than the 172px core) so they only become visible once
     they have cleared its edge. These replace the two static rings that
     used to be drawn as ::before / ::after. */
  .stack-halo {
    position: absolute;
    display: block;
    top: 50%;
    left: 50%;
    height: 68%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%) scale(0.42);
    opacity: 0;
    border: var(--translucent-border-width) solid color-mix(in oklab, var(--accent) 26%, transparent);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    /* Decelerating, so the ring loses energy as it travels out. */
    animation: halo-emit 5.8s cubic-bezier(0.3, 0.6, 0.4, 1)
      var(--halo-delay, 0s) infinite;
    will-change: transform, opacity;
  }
  /* Three rings share one 5.8s lifetime, offset by a third of it, so a new
     halo leaves the core roughly every 1.9s and two are always in flight. */
  .stack-halo:nth-of-type(1) {
    --halo-delay: 0s;
  }
  .stack-halo:nth-of-type(2) {
    --halo-delay: -1.93s;
  }
  .stack-halo:nth-of-type(3) {
    --halo-delay: -3.87s;
  }
  @keyframes halo-emit {
    0% {
      transform: translate(-50%, -50%) scale(0.42);
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    70% {
      opacity: 0.5;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.24);
      opacity: 0;
    }
  }
  .stack-core {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    width: 172px;
    height: 172px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 7px;
    background: #18181c;
    border: 1px solid var(--accent);
    /* Resting value doubles as the reduced-motion state. */
    box-shadow: 0 0 52px color-mix(in oklab, var(--accent) 18%, transparent);
    /* The core's glow swells on the same 5.8s cadence the halos leave on. */
    animation: core-glow 5.8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes core-glow {
    0%,
    100% {
      box-shadow: 0 0 52px color-mix(in oklab, var(--accent) 18%, transparent);
    }
    50% {
      box-shadow: 0 0 78px color-mix(in oklab, var(--accent) 30%, transparent);
    }
  }
  .stack-core strong {
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.7px;
  }
  .stack-node {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: var(--r-pill);
    background: rgba(14, 14, 17, 0.72);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    color: var(--body);
    font-size: 12px;
    white-space: nowrap;
    --dx: 6px;
    --dy: -6px;
    animation: node-drift var(--dur, 9s) ease-in-out var(--delay, 0s) infinite;
    will-change: transform;
  }
  /* --dx / --dy are set per node (a few px at most); the four-step path
     keeps it from reading as a mechanical back-and-forth. */
  @keyframes node-drift {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(var(--dx), var(--dy));
    }
    50% {
      transform: translate(calc(var(--dx) * 0.35), calc(var(--dy) * -0.85));
    }
    75% {
      transform: translate(calc(var(--dx) * -0.75), calc(var(--dy) * 0.45));
    }
  }
  .stack-node img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .stack-node-invert img {
    filter: invert(1);
  }
  .stack-node:nth-of-type(3) {
    left: 9%;
    top: 12%;
  }
  .stack-node:nth-of-type(4) {
    right: 10%;
    top: 10%;
  }
  .stack-node:nth-of-type(5) {
    left: 7%;
    top: 34%;
  }
  .stack-node:nth-of-type(6) {
    right: 6%;
    top: 32%;
  }
  .stack-node:nth-of-type(7) {
    left: 12%;
    bottom: 31%;
  }
  .stack-node:nth-of-type(8) {
    right: 9%;
    bottom: 30%;
  }
  .stack-node:nth-of-type(9) {
    left: 10%;
    bottom: 11%;
  }
  .stack-node:nth-of-type(10) {
    right: 18%;
    bottom: 10%;
  }
  .stack-node:nth-of-type(11) {
    left: 36%;
    top: 5%;
  }
  .stack-node:nth-of-type(12) {
    left: 41%;
    bottom: 15%;
  }
  .stack-node:nth-of-type(13) {
    right: 35%;
    top: 16%;
  }
  /* Per-node drift signatures: differing amplitude, direction, period and
     phase so no two nodes ever line up. */
  .stack-node:nth-of-type(3) { --dx: 6px; --dy: -8px; --dur: 8.5s; --delay: -0.4s; }
  .stack-node:nth-of-type(4) { --dx: -8px; --dy: -6px; --dur: 10s; --delay: -3.1s; }
  .stack-node:nth-of-type(5) { --dx: 8px; --dy: 6px; --dur: 9.6s; --delay: -6.2s; }
  .stack-node:nth-of-type(6) { --dx: -6px; --dy: 8px; --dur: 8.1s; --delay: -1.8s; }
  .stack-node:nth-of-type(7) { --dx: 7px; --dy: -6px; --dur: 10.8s; --delay: -8.5s; }
  .stack-node:nth-of-type(8) { --dx: -8px; --dy: -7px; --dur: 8.8s; --delay: -2.6s; }
  .stack-node:nth-of-type(9) { --dx: 8px; --dy: -6px; --dur: 9.2s; --delay: -5.4s; }
  .stack-node:nth-of-type(10) { --dx: -6px; --dy: -8px; --dur: 10.4s; --delay: -9.7s; }
  .stack-node:nth-of-type(11) { --dx: -7px; --dy: 8px; --dur: 7.7s; --delay: -4.3s; }
  .stack-node:nth-of-type(12) { --dx: 8px; --dy: 6px; --dur: 9.8s; --delay: -7.1s; }
  .stack-node:nth-of-type(13) { --dx: -8px; --dy: 7px; --dur: 8.6s; --delay: -0.9s; }
  @media (prefers-reduced-motion: reduce) {
    .stack-halo,
    .stack-core,
    .stack-node {
      animation: none;
    }
    /* Without the ripple, leave two rings standing so the composition holds. */
    .stack-halo:nth-of-type(1) {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    .stack-halo:nth-of-type(2) {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.68);
    }
  }
  @media (max-width: 1100px) {
    .stack-map {
      max-width: 760px;
      width: 100%;
      margin: 0 auto;
    }
  }
  @media (max-width: 640px) {
    .stack-map {
      min-height: 420px;
    }
    .stack-node {
      gap: 6px;
      padding: 6px 10px;
      font-size: 11px;
    }
    .stack-node img {
      width: 16px;
      height: 16px;
    }
    .stack-core {
      width: 132px;
      height: 132px;
      gap: 5px;
    }
    .stack-core strong {
      font-size: 10px;
      letter-spacing: 0.4px;
    }
    .stack-node:nth-of-type(3) { left: 6%; top: 8%; }
    .stack-node:nth-of-type(4) { right: 6%; top: 8%; }
    .stack-node:nth-of-type(5) { left: 5%; top: 32%; }
    .stack-node:nth-of-type(6) { right: 1%; top: 32%; }
    .stack-node:nth-of-type(7) { left: 6%; bottom: 32%; }
    .stack-node:nth-of-type(8) { right: 6%; bottom: 32%; }
    .stack-node:nth-of-type(9) { left: 6%; bottom: 8%; }
    .stack-node:nth-of-type(10) { right: 6%; bottom: 8%; }
    .stack-node:nth-of-type(11) { left: 35%; top: 2%; }
    .stack-node:nth-of-type(12) { left: 40%; bottom: 16%; }
    .stack-node:nth-of-type(13) { right: 34%; top: 16%; }
  }
  @media (max-width: 380px) {
    .stack-map {
      min-height: 380px;
    }
    .stack-node {
      padding: 5px 8px;
      font-size: 10px;
    }
    .stack-node img {
      width: 14px;
      height: 14px;
    }
    .stack-core {
      width: 116px;
      height: 116px;
    }
    .stack-core strong {
      font-size: 9px;
    }
  }
</style>
