---
import { ArrowRightIcon } from "@phosphor-icons/react"
---

<section class="pricing-final paper-shader" data-warp-shader>
  <div class="container pricing-final-inner">
    <h2 class="t-display-lg">Get started with Ube.</h2>
    <button type="button" class="btn btn-primary" data-pricing-final-cta>
      Request access
      <ArrowRightIcon size={14} aria-hidden="true" />
    </button>
  </div>
</section>

<script src="./final-cta.client.ts"></script>

<style>
  .pricing-final {
    position: relative;
    overflow: hidden;
    padding: 136px 0;
    text-align: center;
  }

  .pricing-final-inner {
    position: relative;
    z-index: 1;
  }

  .pricing-final h2 {
    margin: 0 auto 32px;
    max-width: 820px;
  }

  @media (max-width: 640px) {
    .pricing-final {
      padding: 92px 0;
    }
  }
</style>
