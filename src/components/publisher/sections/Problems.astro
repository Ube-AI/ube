---
import {
  ChartBarIcon,
  GearIcon,
  MegaphoneIcon,
  RepeatIcon,
  SparkleIcon,
} from "@phosphor-icons/react"
import Term from "@/components/Term.astro"
import type { GlossaryKey } from "@/data/glossary"

// Card bodies are split into fragments so jargon can render as an inline
// <Term> (tap-to-reveal) in the middle of running copy.
type BodyPart = string | { term: GlossaryKey; label?: string }
type Card = {
  Icon: typeof GearIcon
  title: string
  body: BodyPart[]
}

const row1: Card[] = [
  {
    Icon: GearIcon,
    title: "Setup takes months.",
    body: [
      "Three analytics ",
      { term: "sdk", label: "SDKs" },
      ". An ",
      { term: "mmp" },
      ". An ",
      { term: "skadnetwork" },
      " schema. Months of setup and debugging before your first ad goes live.",
    ],
  },
  {
    Icon: MegaphoneIcon,
    title: "Advertising is a full-time job.",
    body: [
      "Meta, Google, TikTok, Reddit, all have their own dialect, billing, ",
      { term: "sdk", label: "SDKs" },
      ", and quirks. Learning each one is a full-time job.",
    ],
  },
  {
    Icon: RepeatIcon,
    title: "Growth is a feedback loop.",
    body: [
      "Tune onboarding. Tune difficulty. Tune paywalls. All repetitive work, with a lot of waiting in between steps.",
    ],
  },
]

const row2: Card[] = [
  {
    Icon: SparkleIcon,
    title: "Ad creatives are relentless.",
    body: [
      "Images, videos, playables, seasonal hooks. You need fresh creatives every month to keep customer acquisition costs low.",
    ],
  },
  {
    Icon: ChartBarIcon,
    title: "Dashboards need code context.",
    body: [
      "Twenty-character event names are hard to decipher, requiring the engineer to be in the room when designing dashboards.",
    ],
  },
]
---

<section class="section publisher-problems">
  <div class="container">
    <div class="eyebrow">The problem</div>
    <h2 class="t-display-lg publisher-problems-headline">
      Building isn't the moat anymore.{" "}
      <span class="publisher-problems-headline-accent">
        Distribution is.
      </span>
    </h2>
    <p class="t-body-md body publisher-problems-intro">
      Complicated analytics tools, confusing advertising platforms,
      and time-consuming work prevents your app from reaching its users.
    </p>

    <div class="grid-3 publisher-problems-grid">
      {
        row1.map(({ Icon, title, body }) => (
          <div class="card card-hover publisher-problem-card">
            <div class="publisher-problem-card-icon">
              <Icon size={26} weight="fill" aria-hidden="true" />
            </div>
            <h3 class="t-title-md ink publisher-problem-card-title">{title}</h3>
            <p class="t-body-sm body publisher-problem-card-body">
              {
                body.map((part) =>
                  typeof part === "string" ? (
                    part
                  ) : (
                    <Term term={part.term} label={part.label} />
                  ),
                )
              }
            </p>
          </div>
        ))
      }
    </div>

    <div class="publisher-problems-grid-secondary">
      {
        row2.map(({ Icon, title, body }) => (
          <div class="card card-hover publisher-problem-card">
            <div class="publisher-problem-card-icon">
              <Icon size={26} weight="fill" aria-hidden="true" />
            </div>
            <h3 class="t-title-md ink publisher-problem-card-title">{title}</h3>
            <p class="t-body-sm body publisher-problem-card-body">
              {
                body.map((part) =>
                  typeof part === "string" ? (
                    part
                  ) : (
                    <Term term={part.term} label={part.label} />
                  ),
                )
              }
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .publisher-problems {
    background: var(--canvas-soft);
    /* Only a bottom groove — the TrustedBy band directly above shares this
       same --canvas-soft surface, so a top border here would stack with the
       band's edge into a visible dark seam. Let them read as one panel. */
    border-bottom: 1px solid var(--hairline-soft);
  }
  .publisher-problems-headline {
    margin: 18px 0 0;
    max-width: 880px;
  }
  .publisher-problems-headline-accent {
    color: var(--accent-2);
  }
  .publisher-problems-intro {
    margin: 24px 0 0;
    max-width: 640px;
    line-height: 1.65;
  }
  .publisher-problems-grid {
    margin-top: 64px;
    gap: 24px;
    grid-template-columns: repeat(3, 1fr);
  }
  /* The 3→2 collapse leaves an orphan, so jump straight to a single
     column once the layout can't hold all three across. */
  @media (max-width: 1024px) {
    .publisher-problems-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Secondary row: two cards centered, matching the column width of the
     three-up grid above. Hidden once the main grid collapses. */
  .publisher-problems-grid-secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin: 24px auto 0;
    max-width: calc((100% * 2 - 24px) / 3);
  }
  @media (max-width: 1024px) {
    .publisher-problems-grid-secondary {
      display: none;
    }
  }

  .publisher-problem-card {
    padding: 32px;
  }
  .publisher-problem-card-icon {
    color: var(--mark);
    display: inline-flex;
    margin-bottom: 22px;
  }
  .publisher-problem-card-title {
    margin-bottom: 10px;
  }
  .publisher-problem-card-body {
    margin: 0;
    line-height: 1.6;
  }
</style>
