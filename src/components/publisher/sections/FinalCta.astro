---
// Shared closing CTA — the homepage's, reused as-is on /about/. Each page
// passes its own `source` so Request access clicks stay attributed to the
// page they came from.
import { ArrowRightIcon } from "@phosphor-icons/react"
import type { ModalSource } from "@/stores/request-access"

export interface Props {
  source?: ModalSource
}

const { source = "home_final_cta" } = Astro.props
---

<section class="publisher-final paper-shader" data-warp-shader>
  <div class="container publisher-final-inner">
    <h2 class="t-display-lg">
      Let's grow your app together.
    </h2>
    <p class="t-body-md muted">
      Hand the distribution loop to Ube. Get back to building.
    </p>
    <button
      type="button"
      class="btn btn-primary"
      data-publisher-final-cta={source}
    >
      Request access
      <ArrowRightIcon size={14} aria-hidden="true" />
    </button>
  </div>
</section>

<script src="./final-cta.client.ts"></script>

<style>
  .publisher-final {
    position: relative;
    overflow: hidden;
    padding: 136px 0;
    text-align: center;
  }
  .publisher-final-inner {
    position: relative;
    z-index: 1;
  }
  .publisher-final h2 {
    max-width: 820px;
    margin: 0 auto;
  }
  .publisher-final p {
    max-width: 620px;
    margin: 20px auto 32px;
  }
  @media (max-width: 640px) {
    .publisher-final {
      padding: 92px 0;
    }
  }
</style>
