---
import {
  CaretDownIcon,
  CheckIcon,
  EnvelopeSimpleIcon,
  GameControllerIcon,
  ImageIcon,
  PencilSimpleIcon,
  SparkleIcon,
  UserCircleIcon,
  VideoCameraIcon,
} from "@phosphor-icons/react"

type Format = {
  Icon: typeof ImageIcon
  cls: string
  name: string
  detail: string
  price: string
}

/* Order matters: the client script picks by index — Static ad is where the
   brief arrives, AI UGC is what the pointer chooses. */
const formats: Format[] = [
  {
    Icon: ImageIcon,
    cls: "static-format",
    name: "Static ad",
    detail: "Multi-size set",
    price: "$8",
  },
  {
    Icon: VideoCameraIcon,
    cls: "video-format",
    name: "AI UGC",
    detail: "Generated by AI",
    price: "$24",
  },
  {
    Icon: UserCircleIcon,
    cls: "ugc-format",
    name: "Creator UGC",
    detail: "Creator produced",
    price: "$180",
  },
  {
    Icon: GameControllerIcon,
    cls: "playable-format",
    name: "Playable ad",
    detail: "Interactive demo",
    price: "$340",
  },
]
---

<div
  class="creative-mockup"
  aria-label="An email from Ube with a trend, editable creative brief, approval action, and an open production menu for static images, AI UGC, creator UGC, and playables"
>
  <div class="mockup-chrome creative-shell" data-create-mockup>
    <div class="mockup-header">
      <EnvelopeSimpleIcon size={14} aria-hidden="true" />
      <span class="mono header-label">Inbox</span>
    </div>

    <div class="creative-email">
      <div class="email-meta mono a-rise" data-brief-row>
        <span>From Ube</span>
        <span class="spacer"></span>
        <span>Today, 7:12 AM</span>
      </div>

      <div class="trend-signal a-rise" data-brief-row>
        <span class="trend-icon" aria-hidden="true">
          <SparkleIcon size={13} weight="fill" />
        </span>
        <div>
          <span class="trend-kicker mono">TREND DETECTED</span>
          <span class="trend-copy">“Monday reset” videos are taking off</span>
        </div>
      </div>

      <div class="brief-heading a-rise" data-brief-row>
        <span class="eyebrow brief-eyebrow">Creative brief</span>
        <h4>Your next campaign idea</h4>
      </div>

      <div class="brief-fields a-rise" data-brief-row>
        <div class="brief-field">
          <span class="field-label mono">Headline</span>
          <span class="field-copy">One tiny puzzle to start your day.</span>
          <span class="edit-icon" aria-hidden="true">
            <PencilSimpleIcon size={12} />
          </span>
        </div>
        <div class="brief-field script-field">
          <span class="field-label mono">Script</span>
          <span class="field-copy">
            Open on the morning routine, then reveal today’s challenge.
          </span>
          <span class="edit-icon" aria-hidden="true">
            <PencilSimpleIcon size={12} />
          </span>
        </div>
      </div>

      <div class="approval-row a-rise" data-brief-row>
        {/* The anchor. Everything the dropdown positions against hangs
            off this. */}
        <div class="production-field">
          <div class="production-trigger" data-prod-trigger aria-hidden="true">
            {/* Static ad is the resting format, so this starts as the
                image glyph. The script swaps both glyph and class. */}
            <span class="production-icon static-format" data-prod-icon>
              <ImageIcon size={14} />
            </span>
            <span class="production-value">
              <span class="production-label mono">PRODUCTION</span>
              <span class="production-name" data-prod-name>Static ad</span>
            </span>
            <span class="production-price mono" data-prod-price>$8</span>
            <CaretDownIcon className="production-caret" size={11} />
          </div>

          <div class="format-menu" data-format-menu aria-hidden="true">
            <span class="format-menu-label mono">Choose a format</span>
            {
              formats.map((f, i) => (
                <div
                  class={`format-option ${f.cls}${i === 0 ? " selected" : ""}`}
                  data-format-option
                  data-name={f.name}
                  data-price={f.price}
                >
                  <span class="format-icon">
                    <f.Icon size={13} />
                  </span>
                  <span>
                    <span class="format-name">{f.name}</span>
                    <span class="format-detail mono">{f.detail}</span>
                  </span>
                  <CheckIcon className="format-check" size={12} weight="bold" />
                </div>
              ))
            }
          </div>
        </div>

        <span class="approve-button">Approve</span>
      </div>
    </div>

    <div class="vcursor" data-vcursor aria-hidden="true">
      <span class="vcursor-pulse"></span>
      <span class="vcursor-ring"></span>
      <span class="vcursor-dot"></span>
    </div>
  </div>
</div>

<script src="./create-mockup.client.ts"></script>

<style>
  /* The open menu hangs below the card, so the wrapper holds room for it
     or it lands on whatever comes next. */
  .creative-mockup {
    width: 100%;
    min-width: 0;
    position: relative;
    padding-bottom: 196px;
  }
  /* overflow is visible so the open menu can leave the card, the way a
     Select portalled to the document root does in the app. */
  .creative-shell {
    overflow: visible;
  }
  /* .mockup-chrome normally rounds its children by clipping them. This one
     cannot clip - the menu has to get out - so the header, whose gradient
     is a square-cornered box, has to round its own top corners or it
     squares off the card's. Same radius as the chrome. */
  .creative-shell .mockup-header {
    border-radius: var(--r-xl) var(--r-xl) 0 0;
  }
  .header-label {
    font-size: 11px;
    color: var(--muted);
  }
  .spacer {
    flex: 1;
  }
  .creative-email {
    padding: 18px;
  }
  .email-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 9.5px;
    margin-bottom: 14px;
  }
  .trend-signal {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: var(--translucent-border-width) solid color-mix(in oklab, var(--accent) 32%, transparent);
    border-radius: var(--r-md);
    background: var(--accent-tint);
  }
  .trend-icon {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 16%, var(--canvas));
  }
  .trend-kicker,
  .trend-copy {
    display: block;
  }
  .trend-kicker {
    color: var(--accent);
    font-size: 8.5px;
    letter-spacing: 0.7px;
    margin-bottom: 2px;
  }
  .trend-copy {
    color: var(--ink);
    font-size: 11.5px;
  }
  .brief-heading {
    margin: 16px 0 10px;
  }
  .brief-eyebrow {
    font-size: 9px;
    margin-bottom: 6px;
  }
  .brief-heading h4 {
    color: var(--ink);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
  }
  .brief-fields {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 8px;
  }
  /* Read-only, so these stay recessed on canvas - the contrast with the
     trigger below is the point. */
  .brief-field {
    position: relative;
    min-width: 0;
    padding: 10px 28px 10px 11px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--canvas);
  }
  .field-label,
  .field-copy {
    display: block;
  }
  .field-label {
    color: var(--muted);
    font-size: 8.5px;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .field-copy {
    color: var(--body);
    font-size: 10.5px;
    line-height: 1.4;
  }
  .edit-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    color: var(--muted);
  }
  .approval-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }
  .production-field {
    position: relative;
    min-width: 0;
  }
  /* Same 30px as the Approve button beside it. At that height the stacked
     label-over-value block does not fit, so the label sits inline ahead of
     the value - and the icon loses its 27px tinted tile, which was leaving
     barely 1px of air top and bottom. Bare, it leaves 8px, and the row
     breathes. Elevated too: clickable things sit on surface-elevated and
     read-only things sit down on canvas. */
  .production-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    height: 30px;
    padding: 0 10px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-md);
    background: var(--surface-elevated);
    color: var(--muted);
    text-align: left;
    transition:
      border-color 0.18s var(--ease-out),
      background-color 0.18s var(--ease-out);
  }
  .production-trigger.is-hot {
    border-color: var(--accent);
  }
  /* Mirrors the selected format: the script puts that format's class on
     this span, so --fmt resolves to its colour. */
  .production-icon {
    color: var(--fmt, var(--accent-2));
    flex: none;
    display: inline-flex;
  }
  .production-icon svg {
    width: 14px;
    height: 14px;
  }
  .production-value {
    display: flex;
    align-items: baseline;
    gap: 7px;
    min-width: 0;
  }
  .production-label {
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.6px;
    flex: none;
  }
  .production-name {
    color: var(--ink);
    font-size: 10.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
  }
  .production-price {
    color: var(--ink);
    font-size: 11px;
    margin-left: auto;
    flex: none;
  }
  /* The Select trigger chevron: 50% opacity, points down at rest. */
  .production-caret {
    color: var(--muted);
    flex: none;
    opacity: 0.5;
    transition: transform 0.22s var(--ease-out);
  }
  .production-trigger.is-open .production-caret {
    transform: rotate(180deg);
  }

  /* A real dropdown, anchored under its trigger and tied to its width, the
     way the app's SelectContent takes --radix-select-trigger-width.
     Shadows are otherwise banned in this system; DESIGN.md carves out
     exactly this case, true overlays where an element genuinely leaves the
     page plane. */
  .format-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 3;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--surface-elevated);
    padding: 4px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.42);
    /* Opens the way SelectContent does - zoom-in-95 plus
       slide-in-from-top-2, growing out of the trigger's edge. */
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transform-origin: top center;
    pointer-events: none;
    transition:
      opacity 0.18s var(--ease-out),
      transform 0.22s var(--ease-out);
  }
  .format-menu.is-open {
    opacity: 1;
    transform: none;
  }
  /* Matches SelectLabel: muted, small, inset to the item text. */
  .format-menu-label {
    display: block;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 4px 7px 6px;
    font-size: 8.5px;
  }
  /* A list, not a grid of cards. The options carry no borders of their
     own - selection is the tinted fill and the check, exactly as
     SelectItem does it. */
  .format-option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    padding: 6px 7px;
    border-radius: var(--r-sm);
    transition: background-color 0.16s var(--ease-out);
  }
  .format-option + .format-option {
    margin-top: 2px;
  }
  .format-option.is-hot {
    background: color-mix(in oklab, var(--ink) 6%, transparent);
  }
  .format-option.selected {
    background: var(--accent-tint);
  }
  /* Selected and under the pointer at once: lift the tint rather than
     replace it, so the row does not appear to lose its selection. */
  .format-option.selected.is-hot {
    background: color-mix(in oklab, var(--accent) 22%, transparent);
  }
  /* One token per format, so the colour is stated once and both the menu
     row and the trigger read it from the same place. */
  .static-format {
    --fmt: var(--accent);
  }
  .video-format {
    --fmt: var(--accent-2);
  }
  .ugc-format {
    --fmt: var(--success);
  }
  .playable-format {
    --fmt: var(--warning);
  }
  /* Tiles removed here too. The glyph alone carries the format, and at
     four rows the tinted squares read as a grid of buttons rather than as
     a list of options. */
  .format-icon {
    color: var(--fmt);
    flex: none;
    display: inline-flex;
  }
  .format-icon svg {
    width: 14px;
    height: 14px;
  }
  .format-name,
  .format-detail {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .format-name {
    color: var(--ink);
    font-size: 10.5px;
  }
  .format-detail {
    margin-top: 2px;
    color: var(--body);
    font-size: 8.5px;
  }
  .format-check {
    color: var(--accent);
    margin-left: auto;
    flex: none;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.3s var(--ease-spring);
  }
  .format-option.selected .format-check {
    opacity: 1;
    transform: none;
  }

  /* The CTA is the white pill, per DESIGN.md - the accent never fills a
     button. Scaled to the mockup's own type size. */
  .approve-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 30px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    background: var(--cta-fill);
    color: var(--cta-text);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    .creative-email {
      padding: 14px;
    }
    .email-meta {
      margin-bottom: 10px;
    }
    .brief-fields {
      grid-template-columns: 1fr;
    }
    .script-field {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* The brief rests on its outcome: menu open on AI UGC, and no pointer
       wandering the card. */
    .format-menu,
    .format-check,
    .format-option,
    .production-trigger {
      transition: none;
    }
  }
</style>
