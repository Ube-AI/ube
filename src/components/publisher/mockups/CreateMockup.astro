---
import {
  CaretUpIcon,
  CheckIcon,
  EnvelopeSimpleIcon,
  GameControllerIcon,
  ImageIcon,
  PencilSimpleIcon,
  SparkleIcon,
  UserCircleIcon,
  VideoCameraIcon,
} from "@phosphor-icons/react"
---

<div
  class="creative-mockup"
  aria-label="An email from Ube with a trend, editable creative brief, approval action, and an open production menu for static images, AI UGC, creator UGC, and playables"
>
  <div class="mockup-chrome">
    <div class="mockup-header">
      <EnvelopeSimpleIcon size={14} aria-hidden="true" />
      <span class="mono header-label">Inbox</span>
    </div>

    <div class="creative-email">
      <div class="email-meta mono">
        <span>From Ube</span>
        <span class="spacer"></span>
        <span>Today, 7:12 AM</span>
      </div>

      <div class="trend-signal">
        <span class="trend-icon" aria-hidden="true">
          <SparkleIcon size={13} weight="fill" />
        </span>
        <div>
          <span class="trend-kicker mono">TREND DETECTED</span>
          <span class="trend-copy">“Monday reset” videos are taking off</span>
        </div>
      </div>

      <div class="brief-heading">
        <span class="eyebrow brief-eyebrow">Creative brief</span>
        <h4>Your next campaign idea</h4>
      </div>

      <div class="brief-fields">
        <div class="brief-field">
          <span class="field-label mono">Headline</span>
          <span class="field-copy">One tiny puzzle to start your day.</span>
          <span class="edit-icon" aria-hidden="true">
            <PencilSimpleIcon size={12} />
          </span>
        </div>
        <div class="brief-field script-field">
          <span class="field-label mono">Script</span>
          <span class="field-copy">
            Open on the morning routine, then reveal today’s challenge.
          </span>
          <span class="edit-icon" aria-hidden="true">
            <PencilSimpleIcon size={12} />
          </span>
        </div>
      </div>

      <div class="approval-row">
        <div class="production-option">
          <span class="production-icon" aria-hidden="true">
            <VideoCameraIcon size={14} />
          </span>
          <span>
            <span class="production-label mono">PRODUCTION</span>
            <span class="production-name">AI UGC</span>
          </span>
          <span class="production-price mono">$24</span>
          <CaretUpIcon size={11} aria-hidden="true" />
        </div>
        <span class="approve-button desktop-approve">
          Approve
        </span>
      </div>
    </div>
  </div>

  <div class="format-menu" aria-hidden="true">
    <div class="format-menu-header">
      <span class="mono">Choose a format</span>
    </div>
    <div class="format-grid">
      <div class="format-option static-format">
        <span class="format-icon">
          <ImageIcon size={14} />
        </span>
        <span>
          <span class="format-name">Static ad</span>
          <span class="format-detail mono">Multi-size set</span>
        </span>
      </div>
      <div class="format-option selected video-format">
        <span class="format-icon">
          <VideoCameraIcon size={14} />
        </span>
        <span>
          <span class="format-name">AI UGC</span>
          <span class="format-detail mono">Generated by AI</span>
        </span>
        <CheckIcon className="format-check" size={11} weight="bold" />
      </div>
      <div class="format-option ugc-format">
        <span class="format-icon">
          <UserCircleIcon size={14} />
        </span>
        <span>
          <span class="format-name">Creator UGC</span>
          <span class="format-detail mono">Creator produced</span>
        </span>
      </div>
      <div class="format-option playable-format">
        <span class="format-icon">
          <GameControllerIcon size={14} />
        </span>
        <span>
          <span class="format-name">Playable ad</span>
          <span class="format-detail mono">Interactive demo</span>
        </span>
      </div>
    </div>
  </div>

  <span class="approve-button mobile-approve">
    Approve
  </span>
</div>

<style>
  .creative-mockup {
    width: 100%;
    min-width: 0;
    position: relative;
  }
  .header-label {
    font-size: 11px;
    color: var(--muted);
  }
  .spacer {
    flex: 1;
  }
  .creative-email {
    padding: 18px;
  }
  .email-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 9.5px;
    margin-bottom: 14px;
  }
  .trend-signal {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid color-mix(in oklab, var(--accent) 32%, transparent);
    border-radius: var(--r-md);
    background: var(--accent-tint);
  }
  .trend-icon {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 16%, var(--canvas));
  }
  .trend-kicker,
  .trend-copy {
    display: block;
  }
  .trend-kicker {
    color: var(--accent);
    font-size: 8.5px;
    letter-spacing: 0.7px;
    margin-bottom: 2px;
  }
  .trend-copy {
    color: var(--ink);
    font-size: 11.5px;
  }
  .brief-heading {
    margin: 16px 0 10px;
  }
  .brief-eyebrow {
    font-size: 9px;
    margin-bottom: 6px;
  }
  .brief-heading h4 {
    color: var(--ink);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
  }
  .brief-fields {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 8px;
  }
  .brief-field {
    position: relative;
    min-width: 0;
    padding: 10px 28px 10px 11px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--canvas);
  }
  .field-label,
  .field-copy {
    display: block;
  }
  .field-label {
    color: var(--muted);
    font-size: 8.5px;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .field-copy {
    color: var(--body);
    font-size: 10.5px;
    line-height: 1.4;
  }
  .edit-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    color: var(--muted);
  }
  .approval-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    margin-top: 8px;
  }
  .production-option {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--canvas);
    color: var(--muted);
  }
  .production-icon {
    width: 27px;
    height: 27px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 6px;
    color: var(--mark);
    background: var(--mark-tint);
  }
  .production-label,
  .production-name {
    display: block;
  }
  .production-label {
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.6px;
  }
  .production-name {
    color: var(--ink);
    font-size: 10.5px;
    margin-top: 1px;
  }
  .production-price {
    color: var(--ink);
    font-size: 11px;
    margin-left: auto;
  }
  .approve-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    border-radius: var(--r-md);
    background: var(--accent);
    color: var(--cta-text);
    font-size: 10.5px;
    font-weight: 500;
    white-space: nowrap;
  }
  .mobile-approve {
    display: none;
  }
  .desktop-approve {
    min-width: 108px;
  }
  .format-menu {
    position: relative;
    z-index: 2;
    width: calc(100% - 36px);
    max-width: 380px;
    margin: -10px 18px 0;
    padding: 9px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-lg);
    background: var(--surface-elevated);
    box-shadow: 0 16px 36px rgb(0 0 0 / 24%);
  }
  .format-menu-header {
    display: flex;
    align-items: center;
    padding: 0 3px 7px;
    color: var(--body);
    font-size: 8.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .format-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5px;
  }
  .format-option {
    min-width: 0;
    min-height: 42px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 9px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--canvas);
  }
  .format-option.selected {
    border-color: color-mix(in oklab, var(--accent) 42%, var(--hairline));
    background: color-mix(in oklab, var(--accent) 8%, var(--canvas));
  }
  .format-icon {
    width: 25px;
    height: 25px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 6px;
  }
  .static-format .format-icon {
    color: var(--accent);
    background: var(--accent-tint);
  }
  .video-format .format-icon {
    color: var(--mark);
    background: var(--mark-tint);
  }
  .ugc-format .format-icon {
    color: var(--success);
    background: color-mix(in oklab, var(--success) 13%, transparent);
  }
  .playable-format .format-icon {
    color: var(--warning);
    background: color-mix(in oklab, var(--warning) 13%, transparent);
  }
  .format-name,
  .format-detail {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .format-name {
    color: var(--ink);
    font-size: 10.5px;
  }
  .format-detail {
    margin-top: 2px;
    color: var(--body);
    font-size: 8.5px;
  }
  .format-check {
    position: absolute;
    top: 7px;
    right: 7px;
    color: var(--accent);
  }
  @media (max-width: 540px) {
    .creative-email {
      padding: 14px;
    }
    .email-meta {
      margin-bottom: 10px;
    }
    .brief-fields {
      grid-template-columns: 1fr;
    }
    .script-field {
      display: none;
    }
    .approval-row {
      grid-template-columns: 1fr;
    }
    .desktop-approve {
      display: none;
    }
    .mobile-approve {
      display: inline-flex;
      width: calc(100% - 28px);
      min-height: 36px;
      margin: 8px 14px 0;
    }
    .format-menu {
      width: calc(100% - 28px);
      max-width: none;
      margin-inline: 14px;
    }
    .format-option {
      padding-inline: 7px;
    }
    .format-name {
      font-size: 11px;
    }
  }
</style>
