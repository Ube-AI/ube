---
import Term from "@/components/Term.astro"
import type { GlossaryKey } from "@/data/glossary"
import { integrationLogos } from "@/lib/integration-logos"

type Kpi = {
  label: string
  term: GlossaryKey
  value: string
  delta: string
  up: boolean
}

const kpis: Kpi[] = [
  { label: "DAU", term: "dau", value: "8,412", delta: "+ 12 %", up: true },
  { label: "D7", term: "d7", value: "32 %", delta: "+ 2 %", up: true },
  { label: "CAC", term: "cac", value: "$1.42", delta: "− 8 %", up: true },
  { label: "LTV/30", term: "ltv30", value: "$3.18", delta: "+ 4 %", up: true },
]
---

<div class="mockup-chrome dash-shell" data-measure-mockup>
  <div class="mockup-header">
    <span class="mono header-label a-rise" data-dash-head>
      Dashboard · <span class="ink">Top-line Metrics</span><span class="header-label-extra"> · Last 30 days</span>
    </span>
    <span class="spacer"></span>
    <img
      class="dash-logo a-rise"
      data-dash-head
      src={integrationLogos.amplitude.src}
      alt="Amplitude"
      width="14"
      height="14"
      loading="lazy"
    />
  </div>
  <div class="dash-mockup">
    <div class="dash-kpi-row">
      {
        kpis.map((k) => (
          <div class="dash-kpi a-rise" data-dash-kpi>
            <div class="l mono">
              <Term term={k.term} label={k.label} />
            </div>
            {/* buildReels clears its host first, so the literal value here
                is what shows until (or if) the script runs. */}
            <div class="v mono">
              <span data-dash-roll={k.value}>{k.value}</span>
            </div>
            <div class={`d mono ${k.up ? "up" : "down"}`} data-dash-delta>
              {k.delta}
            </div>
          </div>
        ))
      }
    </div>
    <div class="dash-chart a-rise" data-dash-chart>
      <div class="dash-chart-head">
        <span class="mono dash-chart-title">D7 retention by cohort</span>
        <span class="spacer"></span>
        <span class="mono dash-legend control">
          <span class="legend-swatch"></span> control
        </span>
        <span class="mono dash-legend variant">
          <span class="legend-swatch"></span> variant B
        </span>
      </div>
      {/* The presentation attributes moved into classes so the animation
          layer has something to hang transitions off. */}
      <svg viewBox="0 0 540 130" width="100%" height="130" aria-hidden="true">
        <line class="dash-grid" x1="0" y1="30" x2="540" y2="30"></line>
        <line class="dash-grid" x1="0" y1="60" x2="540" y2="60"></line>
        <line class="dash-grid" x1="0" y1="90" x2="540" y2="90"></line>
        <line class="dash-grid" x1="0" y1="120" x2="540" y2="120"></line>

        {/* One group per cohort so the two can be staggered. The empty rect
            only exists to pin the group's bounding box to the viewBox; see
            .dash-draw. */}
        <g class="dash-draw" data-dash-draw>
          <rect x="0" y="0" width="540" height="130" fill="none"></rect>
          <path
            class="dash-line dash-line-control"
            d="M10 100 L80 90 L150 84 L220 78 L290 76 L360 72 L430 71 L510 70"
          ></path>
        </g>
        <g class="dash-draw" data-dash-draw>
          <rect x="0" y="0" width="540" height="130" fill="none"></rect>
          <path
            class="dash-line dash-line-variant"
            d="M10 100 L80 84 L150 70 L220 60 L290 50 L360 42 L430 36 L510 30"
          ></path>
        </g>

        <circle class="dash-dot dash-dot-control" data-dash-dot cx="510" cy="70" r="3"></circle>
        <circle class="dash-dot dash-dot-variant" data-dash-dot cx="510" cy="30" r="3"></circle>

        <text class="dash-axis" x="10" y="125">D0</text>
        <text class="dash-axis" x="81" y="125">D1</text>
        <text class="dash-axis" x="152" y="125">D2</text>
        <text class="dash-axis" x="223" y="125">D3</text>
        <text class="dash-axis" x="294" y="125">D4</text>
        <text class="dash-axis" x="365" y="125">D5</text>
        <text class="dash-axis" x="436" y="125">D6</text>
        <text class="dash-axis" x="507" y="125">D7</text>
      </svg>
    </div>
  </div>
</div>

<script src="./measure-mockup.client.ts"></script>

<style>
  /* The draw curve. Holds a beat on D0, builds through midweek, then
     settles into D7 rather than slamming into it. Both control points sit
     right of centre in x, which keeps the peak late and the run reading as
     growth; the flat exit tangent is the landing. */
  .dash-shell {
    --draw-ease: cubic-bezier(0.72, 0.02, 0.55, 1);
  }
  .header-label {
    font-size: 11px;
    color: var(--muted);
  }
  .spacer {
    flex: 1;
  }
  .dash-mockup {
    padding: 18px;
  }
  .dash-kpi-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }
  .dash-kpi {
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    padding: 10px 12px;
    background: var(--canvas);
    min-width: 0;
  }
  .dash-kpi .l {
    font-size: 9px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.7px;
  }
  .dash-kpi .v {
    font-size: 15px;
    color: var(--ink);
    margin-top: 4px;
  }
  .dash-kpi .d {
    font-size: 9.5px;
    margin-top: 2px;
  }
  .dash-kpi .d.up {
    color: var(--success);
  }
  .dash-kpi .d.down {
    color: var(--error);
  }
  .dash-chart {
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    padding: 14px;
    background: var(--canvas);
  }
  .dash-chart-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .dash-chart-title {
    font-size: 10px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  .dash-legend {
    font-size: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .dash-legend.control {
    color: var(--accent);
  }
  .dash-legend.variant {
    color: var(--success);
  }
  .dash-legend .legend-swatch {
    width: 8px;
    height: 2px;
    display: inline-block;
  }
  .dash-legend.control .legend-swatch {
    background: var(--accent);
  }
  .dash-legend.variant .legend-swatch {
    background: var(--success);
  }
  .mockup-header .dash-logo {
    object-fit: contain;
    flex-shrink: 0;
    display: block;
    width: 14px;
    height: 14px;
  }

  /* ----- animation layer ----------------------------------------- */

  .dash-grid {
    stroke: var(--hairline);
    stroke-width: 0.5;
  }
  .dash-axis {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
  }
  .dash-dot-control {
    fill: var(--accent);
  }
  .dash-dot-variant {
    fill: var(--success);
  }

  .dash-kpi .d[data-dash-delta] {
    opacity: 0;
    transform-origin: left center;
  }
  .dash-kpi .d.is-stamped {
    animation: delta-stamp 340ms var(--ease-out) both;
  }

  .dash-line {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dash-line-control {
    stroke: var(--accent);
  }
  .dash-line-variant {
    stroke: var(--success);
  }

  /* The draw is a wipe, not a dash. stroke-dashoffset advances by arc
     length, and variant B climbs a good deal further than control does, so
     mid-draw the two cohorts sat on different days - the green line
     visibly behind the purple one in x, for no reason a reader could name.
     A clip edge sweeping D0 to D7 puts both on the one time axis, which is
     also what lets --draw-ease mean anything: it now shapes progress
     across the week rather than progress along two unequal strings.

     Insets are in the SVG's own user units, so they are the same numbers as
     the path data: 540 - 10 parks the edge on D0, 540 - 510 on D7. The
     full-viewBox rect inside each group is what makes that true - it pins
     the group's bounding box to the viewBox, so the clip has room for the
     stroke and round caps above and below the paths. */
  .dash-draw {
    clip-path: inset(0 530px 0 0);
  }
  .dash-draw.is-drawn {
    clip-path: inset(0 30px 0 0);
    transition: clip-path var(--draw-dur, 1400ms) var(--draw-ease)
      var(--draw-delay, 0ms);
  }

  @keyframes dot-land {
    0% {
      opacity: 0;
      transform: scale(0.2);
    }
    60% {
      opacity: 1;
      transform: scale(1.16);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  .dash-dot {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .dash-dot.is-in {
    animation: dot-land 260ms var(--ease-out) both;
  }

  @media (prefers-reduced-motion: reduce) {
    /* The dashboard reads as the finished state: numbers set, deltas
       stamped, both cohort lines drawn end to end. */
    .dash-kpi .d[data-dash-delta] {
      opacity: 1;
    }
    .dash-kpi .d.is-stamped {
      animation: none;
    }
    .dash-draw,
    .dash-draw.is-drawn {
      clip-path: inset(0 30px 0 0);
      transition: none;
    }
    .dash-dot {
      opacity: 1;
    }
    .dash-dot.is-in {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .dash-kpi-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .header-label-extra {
      display: none;
    }
  }
</style>
