---
import { Logo } from "@/lib/logo"
import {
  ArrowRightIcon,
  PlantIcon,
  SparkleIcon,
} from "@phosphor-icons/react"
import IntegrationsMap from "@/components/publisher/mockups/IntegrationsMap.astro"
import { heroRightRoom } from "@/data/integrations-map"

const mapRightRoom = `${(heroRightRoom * 100).toFixed(2)}%`
---

<section class="publisher-hero" id="top">
  <div class="publisher-hero-grid-bg" aria-hidden="true"></div>
  <div class="container publisher-hero-inner">
    <div class="publisher-hero-copy fade-in">
      <div class="eyebrow publisher-hero-eyebrow">Mobile app growth</div>
      <h1 class="t-display-mega publisher-hero-title">
        Everything you need
        <br />
        <span class="publisher-hero-title-muted">to distribute your app.</span>
      </h1>
      <p class="t-body-md body publisher-hero-body">
        All the market-leading growth tools top studios run on packaged for small teams.
        Months of complicated analytics set-up, testing, and advertising automated within an <b>agentic AI platform</b>.
      </p>
      <div class="publisher-cta-row">
        <button type="button" class="btn btn-primary" data-publisher-hero-cta>
          Request access
          <ArrowRightIcon size={14} aria-hidden="true" />
        </button>
        <a class="btn btn-secondary" href="#loop">See how it works</a>
      </div>
      <div class="publisher-builtfor">
        <span class="builtfor-label">Built for</span>
        <span class="builtfor-chip">
          <span class="builtfor-chip-mark" style="color: var(--accent)">
            <SparkleIcon size={12} aria-hidden="true" />
          </span>
          Vibecoders
        </span>
        <span class="builtfor-chip">
          <span class="builtfor-chip-mark" style="color: var(--success)">
            <PlantIcon size={12} aria-hidden="true" />
          </span>
          Solo founders
        </span>
        <span class="builtfor-chip">
          <span class="builtfor-chip-mark">
            <Logo name="react" size={12} />
          </span>
          Indie studios
        </span>
      </div>
    </div>

    <div class="publisher-hero-visual fade-in">
      <IntegrationsMap />
    </div>
  </div>
</section>

<script src="./hero.client.ts"></script>

<style define:vars={{ mapRightRoom }}>
  .publisher-hero {
    position: relative;
    overflow: hidden;
    padding: 144px 0 176px;
    border-bottom: 1px solid var(--hairline-soft);
  }
  .publisher-hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.14) 1px,
      transparent 1px
    );
    background-size: 32px 32px;
    opacity: 0.55;
    pointer-events: none;
    mask-image: radial-gradient(
      ellipse 80% 62% at 50% 28%,
      #000 0%,
      transparent 76%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 62% at 50% 28%,
      #000 0%,
      transparent 76%
    );
  }
  .publisher-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .publisher-hero-inner > * {
    min-width: 0;
  }
  .publisher-hero-copy {
    container-type: inline-size;
  }
  .publisher-hero-eyebrow {
    margin-bottom: 28px;
  }
  .publisher-hero-title {
    margin: 0;
    color: var(--ink);
    /* Keep each phrase on its own line at every screen size. */
    white-space: nowrap;
  }
  .publisher-hero-title-muted {
    color: var(--muted);
  }
  .publisher-hero-body {
    margin-top: 32px;
    max-width: 520px;
    line-height: 1.6;
  }
  .publisher-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .publisher-builtfor {
    display: block;
    margin-top: 48px;
    color: var(--body);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }
  .publisher-builtfor .builtfor-label,
  .publisher-builtfor .builtfor-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: 14px;
    margin-block: 6px;
    white-space: nowrap;
    vertical-align: middle;
  }
  .publisher-builtfor .builtfor-label {
    color: var(--muted);
    font-weight: 600;
    letter-spacing: 1.2px;
    margin-right: 18px;
  }
  .publisher-builtfor .builtfor-chip-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .publisher-hero-visual {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 520px;
    min-width: 0;
  }

  @media (min-width: 1101px) {
    .publisher-hero {
      padding: 48px 0 128px;
    }
    /* The map stands taller than the copy beside it, so on a laptop it is
       held to the screen's height, with the legend just under the fold, and
       on a taller screen it fills its column. The 121px is the nav (73) and
       the padding above (48); the 0.8 is the map's width over its height
       (520 by 650). It sits at the column's right edge, moved right by the
       room the drawing leaves beside its rightmost circle, so that circle
       lines up with the nav's right edge as the copy lines up with the logo. */
    .publisher-hero-visual {
      justify-self: end;
      max-width: max(340px, calc((100svh - 121px) * 0.8));
      translate: var(--mapRightRoom) 0;
    }
  }
  @media (min-width: 1025px) {
    .publisher-hero-title {
      font-size: min(clamp(44px, 4.55vw, 58px), 9.5cqi);
      line-height: 1.05;
    }
  }
  @media (max-width: 1100px) {
    .publisher-hero-inner {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }
  @media (max-width: 1024px) {
    .publisher-hero {
      padding: 104px 0 112px;
    }
    .publisher-hero-title {
      /* Size both phrases to the copy column while preserving two lines;
         9.5cqi fits "to distribute your app." at normal letter-spacing. */
      font-size: min(52px, 9.5cqi);
    }
  }
  @media (max-width: 640px) {
    .publisher-hero {
      padding: 80px 0 88px;
    }
    .publisher-hero-title {
      font-size: min(44px, 9.5cqi);
    }
  }
</style>
