---
import {
  CaretDownIcon,
  CheckIcon,
  EnvelopeSimpleIcon,
  PencilSimpleIcon,
  SparkleIcon,
  TrendUpIcon,
  VideoCameraIcon,
} from "@phosphor-icons/react"
---

<div
  class="creative-mockup"
  aria-label="An email from Ube with a TikTok trend, editable creative brief, production cost, and approval action"
>
  <div class="mockup-chrome">
    <div class="mockup-header">
      <EnvelopeSimpleIcon size={14} aria-hidden="true" />
      <span class="mono header-label">
        Inbox · <span class="ink">Ube</span>
      </span>
      <span class="spacer"></span>
      <span class="pill pill-accent">
        <TrendUpIcon size={9} aria-hidden="true" /> TikTok trend
      </span>
    </div>

    <div class="creative-email">
      <div class="email-meta mono">
        <span>From Ube</span>
        <span class="spacer"></span>
        <span>Today, 7:12 AM</span>
      </div>

      <div class="trend-signal">
        <span class="trend-icon" aria-hidden="true">
          <SparkleIcon size={13} weight="fill" />
        </span>
        <div>
          <span class="trend-kicker mono">TREND DETECTED</span>
          <span class="trend-copy">“Monday reset” videos are taking off</span>
        </div>
      </div>

      <div class="brief-heading">
        <span class="eyebrow brief-eyebrow">Creative brief</span>
        <h4>Your next campaign idea</h4>
      </div>

      <div class="brief-fields">
        <div class="brief-field">
          <span class="field-label mono">Headline</span>
          <span class="field-copy">One tiny puzzle to start your day.</span>
          <span class="edit-icon" aria-hidden="true">
            <PencilSimpleIcon size={12} />
          </span>
        </div>
        <div class="brief-field script-field">
          <span class="field-label mono">Script</span>
          <span class="field-copy">
            Open on the morning routine, then reveal today’s challenge.
          </span>
          <span class="edit-icon" aria-hidden="true">
            <PencilSimpleIcon size={12} />
          </span>
        </div>
      </div>

      <div class="approval-row">
        <div class="production-option">
          <span class="production-icon" aria-hidden="true">
            <VideoCameraIcon size={14} />
          </span>
          <span>
            <span class="production-label mono">PRODUCTION</span>
            <span class="production-name">AI UGC video</span>
          </span>
          <span class="production-price mono">$24</span>
          <CaretDownIcon size={11} aria-hidden="true" />
        </div>
        <span class="approve-button">
          Approve creative
        </span>
      </div>

      <div class="production-note mono">
        Static included · Studio production quoted before approval
      </div>
    </div>
  </div>

  <div class="creative-status">
    <span class="status-check" aria-hidden="true">
      <CheckIcon size={11} weight="bold" />
    </span>
    <span>Creative added</span>
    <span class="status-arrow" aria-hidden="true">→</span>
    <span>Campaigns queued</span>
  </div>
</div>

<style>
  .creative-mockup {
    width: 100%;
    min-width: 0;
  }
  .header-label {
    font-size: 11px;
    color: var(--muted);
  }
  .spacer {
    flex: 1;
  }
  .creative-email {
    padding: 18px;
  }
  .email-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 9.5px;
    margin-bottom: 14px;
  }
  .trend-signal {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid color-mix(in oklab, var(--accent) 32%, transparent);
    border-radius: var(--r-md);
    background: var(--accent-tint);
  }
  .trend-icon {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 16%, var(--canvas));
  }
  .trend-kicker,
  .trend-copy {
    display: block;
  }
  .trend-kicker {
    color: var(--accent);
    font-size: 8.5px;
    letter-spacing: 0.7px;
    margin-bottom: 2px;
  }
  .trend-copy {
    color: var(--ink);
    font-size: 11.5px;
  }
  .brief-heading {
    margin: 16px 0 10px;
  }
  .brief-eyebrow {
    font-size: 9px;
    margin-bottom: 6px;
  }
  .brief-heading h4 {
    color: var(--ink);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
  }
  .brief-fields {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 8px;
  }
  .brief-field {
    position: relative;
    min-width: 0;
    padding: 10px 28px 10px 11px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--canvas);
  }
  .field-label,
  .field-copy {
    display: block;
  }
  .field-label {
    color: var(--muted);
    font-size: 8.5px;
    letter-spacing: 0.7px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .field-copy {
    color: var(--body);
    font-size: 10.5px;
    line-height: 1.4;
  }
  .edit-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    color: var(--muted);
  }
  .approval-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    margin-top: 8px;
  }
  .production-option {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--canvas);
    color: var(--muted);
  }
  .production-icon {
    width: 27px;
    height: 27px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 6px;
    color: var(--mark);
    background: var(--mark-tint);
  }
  .production-label,
  .production-name {
    display: block;
  }
  .production-label {
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.6px;
  }
  .production-name {
    color: var(--ink);
    font-size: 10.5px;
    margin-top: 1px;
  }
  .production-price {
    color: var(--ink);
    font-size: 11px;
    margin-left: auto;
  }
  .approve-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    border-radius: var(--r-md);
    background: var(--accent);
    color: var(--cta-text);
    font-size: 10.5px;
    font-weight: 500;
    white-space: nowrap;
  }
  .production-note {
    color: var(--muted);
    font-size: 8.5px;
    margin: 7px 0 0 2px;
  }
  .creative-status {
    width: fit-content;
    max-width: calc(100% - 24px);
    margin: -1px auto 0;
    padding: 8px 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid color-mix(in oklab, var(--success) 40%, transparent);
    border-top: 0;
    border-radius: 0 0 var(--r-md) var(--r-md);
    background: color-mix(in oklab, var(--success) 7%, var(--surface-card));
    color: var(--body);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2px;
  }
  .status-check {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in oklab, var(--success) 18%, transparent);
    color: var(--success);
  }
  .status-arrow {
    color: var(--success);
  }
  @media (max-width: 540px) {
    .creative-email {
      padding: 14px;
    }
    .email-meta {
      margin-bottom: 10px;
    }
    .brief-fields {
      grid-template-columns: 1fr;
    }
    .script-field {
      display: none;
    }
    .approval-row {
      grid-template-columns: 1fr;
    }
    .approve-button {
      min-height: 36px;
    }
    .production-note {
      text-align: center;
      line-height: 1.4;
    }
    .creative-status {
      gap: 6px;
      font-size: 8.5px;
      padding-inline: 10px;
    }
  }
</style>
